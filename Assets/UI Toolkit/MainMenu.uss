:root {
}

.panel {
    align-items: flex-end;
    justify-content: flex-end;
    display: flex;
    height: 100%;
}

.main-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 400px;
    padding: 24px;
}

.title-container {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 50px;
    white-space: nowrap;
    margin-bottom: 100px; 
}

.buttons-container {
    display: flex;
    flex-direction: column;
}

.menu-button {
    width: 100%;
    height: 40px;
    font-size: 28px;
    margin: 0 0 20px 0;
    padding: 0;
    -unity-text-align: middle-right;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(188, 188, 188, 0);
}

.quit-button {
    color: rgb(154, 154, 154);
}

.menu-button:hover {
    color: rgb(188, 188, 188);
}

.menu-button:active {
    color: rgb(231, 231, 231);
}
